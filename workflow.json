                  "skill_name": "auth-implementation-patterns",
                  "skill_dir": "plugins/developer-essentials/skills/auth-implementation-patterns",
                  "composite": 0.864
                },
                {
                  "concept": "Data classification + encryption design",
                  "why": "Classify every data type as public, internal, PII, or secret. Per class, define encryption at rest, encryption in transit, retention period, and access roles. The matrix drives schema, storage, and access-control decisions.",
                  "example_id": "dffa4ecc5bececc7",
                  "example_label": "healthcare-phi-compliance",
                  "source_repo": "affaan-m/everything-claude-code",
                  "source_ref": "main",
                  "source_path": "skills/healthcare-phi-compliance/SKILL.md",
