              "picks": [
                {
                  "concept": "Secrets management",
                  "why": "Vault / AWS Secrets Manager / GCP Secret Manager / Doppler. Never commit credentials to git, never echo them in logs. Rotate on a schedule. Prefer short-lived tokens over long-lived API keys where possible.",
                  "example_id": "531201d0a4a13bf3",
                  "example_label": "secrets-management",
